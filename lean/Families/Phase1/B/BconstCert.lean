/-- `bfac p − 1 ≤ (1 + 3/P) p^{−3/2}` for `p > P ≥ 4`. -/
lemma bfac_sub_one_le_tail {P p : ℕ} (hP : 4 ≤ P) (hp : P < p) :
    bfac p - 1 ≤ (1 + 3 / (P : ℝ)) * (p : ℝ) ^ (-(3 / 2 : ℝ)) := by
  have hP4 : (4 : ℝ) ≤ P := by exact_mod_cast hP
  have hpP : (P : ℝ) + 1 ≤ p := by exact_mod_cast hp
  have hp0 : (0 : ℝ) < p := by linarith
  set u := (p : ℝ) ^ (1 / 2 : ℝ) with hu
  have hu0 : 0 < u := Real.rpow_pos_of_pos hp0 _
  have huu : u * u = p := by rw [hu, ← Real.rpow_add hp0]; norm_num
  have hu2 : 2 < u := by nlinarith
  have e1 : (p : ℝ) ^ (-(1 / 2 : ℝ)) = 1 / u := by rw [Real.rpow_neg hp0.le, ← hu, one_div]
  have e3 : (p : ℝ) ^ (-(3 / 2 : ℝ)) = 1 / (u * u * u) := by
    rw [show -(3 / 2 : ℝ) = -(1 / 2) + (-1) by norm_num, Real.rpow_add hp0, Real.rpow_neg_one, e1,
      ← huu]; field_simp
  unfold bfac
  rw [e1, e3, ← huu]
  have hP0 : (0 : ℝ) < P := by linarith
  have hu21 : 0 < u * u - 1 := by nlinarith
  -- `A = 1/(u(u²−1)) ≤ (1 + 2/P)/u³` and `B = 1/(u⁴(u²−1)) ≤ (1/P)/u³`
  have tA : 1 / u / (u * u - 1) ≤ (1 + 2 / (P : ℝ)) * (1 / (u * u * u)) := by
    rw [div_div, div_le_iff₀ (by positivity)]
    have : (1 + 2 / (P : ℝ)) * (1 / (u * u * u)) * (u * (u * u - 1)) =
        (1 + 2 / (P : ℝ)) * (u * u - 1) / (u * u) := by field_simp
    rw [this, le_div_iff₀ (by positivity)]
    have : 2 / (P : ℝ) * (u * u) ≥ 1 + 2 / (P : ℝ) := by
      rw [ge_iff_le, ← sub_nonneg]
      have : 2 / (P : ℝ) * (u * u) - (1 + 2 / (P : ℝ)) = (2 * (u * u) - P - 2) / P := by
        field_simp; ring
      rw [this]; apply div_nonneg _ hP0.le; nlinarith
    nlinarith
  have tB : (u * u)⁻¹ / (u * u * (u * u - 1)) ≤ 1 / (P : ℝ) * (1 / (u * u * u)) := by
    have e1 : (u * u)⁻¹ / (u * u * (u * u - 1)) = 1 / (u * u * (u * u * (u * u - 1))) := by
      rw [inv_eq_one_div, div_div]
    have e2 : 1 / (P : ℝ) * (1 / (u * u * u)) = 1 / (P * (u * u * u)) := by
      rw [one_div_mul_one_div]
    rw [e1, e2]
    apply one_div_le_one_div_of_le (by positivity)
    have hPu : (P : ℝ) ≤ u * u - 1 := by linarith
    have h3 : 0 < u * u * u := by positivity
    have h4 : u * u - 1 ≤ u * (u * u - 1) := by nlinarith
    calc (P : ℝ) * (u * u * u) ≤ (u * (u * u - 1)) * (u * u * u) :=
          mul_le_mul_of_nonneg_right (hPu.trans h4) h3.le
      _ = u * u * (u * u * (u * u - 1)) := by ring
  have : (1 + 3 / (P : ℝ)) * (1 / (u * u * u)) =
      (1 + 2 / (P : ℝ)) * (1 / (u * u * u)) + 1 / (P : ℝ) * (1 / (u * u * u)) := by ring
  linarith

/-- The tail sum: for a finite set `U` of primes `> P` (`P ≥ 4`), `∑_{p∈U} (bfac p − 1) ≤ T(P)`. -/
lemma tail_sum_le (P : ℕ) (hP : 4 ≤ P) (U : Finset ℕ) (hU : ∀ p ∈ U, p.Prime ∧ P < p) :
    ∑ p ∈ U, (bfac p - 1) ≤ (1 + 3 / (P : ℝ)) *
      (3 * Real.log 4 * ((P + 1 : ℕ) : ℝ) ^ (-(1 / 2 : ℝ)) / Real.log (P + 1 : ℕ)) := by
  set N := U.sup id with hN
  have hsub : U ⊆ (Finset.Ioc P N).filter Nat.Prime := by
    intro p hp
    rw [Finset.mem_filter, Finset.mem_Ioc]
    exact ⟨⟨(hU p hp).2, Finset.le_sup (f := id) hp⟩, (hU p hp).1⟩
  have hc : 0 ≤ 1 + 3 / (P : ℝ) := by positivity
  calc ∑ p ∈ U, (bfac p - 1) ≤ ∑ p ∈ U, (1 + 3 / (P : ℝ)) * (p : ℝ) ^ (-(3 / 2 : ℝ)) :=
        Finset.sum_le_sum fun p hp => bfac_sub_one_le_tail hP (hU p hp).2
    _ ≤ ∑ p ∈ (Finset.Ioc P N).filter Nat.Prime, (1 + 3 / (P : ℝ)) * (p : ℝ) ^ (-(3 / 2 : ℝ)) :=
        Finset.sum_le_sum_of_subset_of_nonneg hsub fun p _ _ =>
          mul_nonneg hc (Real.rpow_nonneg (Nat.cast_nonneg _) _)
    _ = (1 + 3 / (P : ℝ)) * ∑ n ∈ Finset.Ioc P N,
          (if n.Prime then (n : ℝ) ^ (-(3 / 2 : ℝ)) else 0) := by
        rw [Finset.sum_filter, Finset.mul_sum]
        exact Finset.sum_congr rfl fun n _ => by split_ifs <;> simp
    _ ≤ _ := mul_le_mul_of_nonneg_left (sum_prime_rpow_tail_le P (by omega) N) hc

/-- `exp x ≤ 1/(1 − x)` for `x < 1`. -/
lemma exp_le_inv_one_sub {x : ℝ} (hx : x < 1) : Real.exp x ≤ 1 / (1 - x) := by
  have h := Real.add_one_le_exp (-x)
  have hpos := Real.exp_pos x
  have he : Real.exp x * Real.exp (-x) = 1 := by rw [← Real.exp_add]; simp
  rw [le_div_iff₀ (by linarith)]
  nlinarith

/-- `Nat.Primes ↪ ℕ`. -/
def primesEmb : Nat.Primes ↪ ℕ := ⟨fun p => p, Nat.Primes.coe_nat_injective⟩

/-- The head set `{p ≤ 10⁵ prime}`. -/
def headP : Finset ℕ := (Finset.Ico 2 100001).filter Nat.Prime

lemma bhead_eq : bhead 2 99999 = ∏ p ∈ headP, bfac p := rfl

lemma bfac_pos {p : ℕ} (hp : 2 ≤ p) : 0 < bfac p := lt_of_lt_of_le one_pos (one_le_bfac' hp)

/-- The numerical tail constant: `T(10⁵) ≤ 0.0011868`. -/
lemma tail_const_le :
    (1 + 3 / ((100000 : ℕ) : ℝ)) * (3 * Real.log 4 * ((100000 + 1 : ℕ) : ℝ) ^ (-(1 / 2 : ℝ)) /
      Real.log (100000 + 1 : ℕ)) ≤ 0.0011868 := by
  have hl2 := Real.log_two_lt_d9
  have hl2' := Real.log_two_gt_d9
  have hlog4 : Real.log 4 ≤ 1.3863 := by
    rw [show (4 : ℝ) = 2 ^ 2 by norm_num, Real.log_pow]; push_cast; linarith
  have hlog4' : 0 < Real.log 4 := Real.log_pos (by norm_num)
  have hlgN : 11.0903 ≤ Real.log (100000 + 1 : ℕ) := by
    have : Real.log (65536 : ℝ) ≤ Real.log ((100000 + 1 : ℕ) : ℝ) :=
      Real.log_le_log (by norm_num) (by norm_num)
    rw [show (65536 : ℝ) = 2 ^ 16 by norm_num, Real.log_pow] at this
    push_cast at this; linarith
  have hr : ((100000 + 1 : ℕ) : ℝ) ^ (-(1 / 2 : ℝ)) ≤ 1 / 316 := by
    rw [Real.rpow_neg (by positivity), ← Real.sqrt_eq_rpow, one_div]
    apply inv_anti₀ (by norm_num)
    rw [Real.le_sqrt (by norm_num) (by positivity)]; norm_num
  have hr0 : 0 ≤ ((100000 + 1 : ℕ) : ℝ) ^ (-(1 / 2 : ℝ)) := Real.rpow_nonneg (by positivity) _
  have hlg0 : 0 < Real.log (100000 + 1 : ℕ) := Real.log_pos (by norm_num)
  calc (1 + 3 / ((100000 : ℕ) : ℝ)) * (3 * Real.log 4 * ((100000 + 1 : ℕ) : ℝ) ^ (-(1 / 2 : ℝ)) /
        Real.log (100000 + 1 : ℕ))
      ≤ (1 + 3 / ((100000 : ℕ) : ℝ)) * (3 * 1.3863 * (1 / 316) / 11.0903) := by
        apply mul_le_mul_of_nonneg_left _ (by positivity)
        rw [div_le_div_iff₀ hlg0 (by norm_num)]
        have h1 : 3 * Real.log 4 * ((100000 + 1 : ℕ) : ℝ) ^ (-(1 / 2 : ℝ)) ≤ 3 * 1.3863 * (1 / 316) := by
          have := mul_le_mul hlog4 hr hr0 (by norm_num)
          nlinarith
        have h2 : 0 ≤ 3 * Real.log 4 * ((100000 + 1 : ℕ) : ℝ) ^ (-(1 / 2 : ℝ)) := by positivity
        nlinarith
    _ ≤ 0.0011868 := by norm_num

/-- **`B < 3.73`** (`lem:fS`(iii), certified). -/
theorem Bconst_lt : Bconst < 3.73 := by
  set T : ℝ := (1 + 3 / ((100000 : ℕ) : ℝ)) * (3 * Real.log 4 *
    ((100000 + 1 : ℕ) : ℝ) ^ (-(1 / 2 : ℝ)) / Real.log (100000 + 1 : ℕ)) with hT
  have hT0 : T ≤ 0.0011868 := tail_const_le
  have hhead := head_le
  rw [bhead_eq] at hhead
  have hHpos : 0 < ∏ p ∈ headP, bfac p :=
    Finset.prod_pos fun p hp => bfac_pos (Finset.mem_Ico.mp (Finset.mem_filter.mp hp).1).1
  have hlogH : Real.log (∏ p ∈ headP, bfac p) = ∑ p ∈ headP, Real.log (bfac p) :=
    Real.log_prod fun p hp => (bfac_pos (Finset.mem_Ico.mp (Finset.mem_filter.mp hp).1).1).ne'
  -- every finite partial sum of `log bfac` over the primes is `≤ log H + T`
  have hsum : ∀ U : Finset Nat.Primes, ∑ p ∈ U, Real.log (bfac p) ≤
      Real.log (∏ p ∈ headP, bfac p) + T := by
    intro U
    rw [hlogH, ← Finset.sum_filter_add_sum_filter_not U (fun p : Nat.Primes => (p : ℕ) ≤ 100000)]
    have h1 : ∑ p ∈ U.filter (fun p : Nat.Primes => (p : ℕ) ≤ 100000), Real.log (bfac p) ≤
        ∑ p ∈ headP, Real.log (bfac p) := by
      rw [show ∑ p ∈ U.filter (fun p : Nat.Primes => (p : ℕ) ≤ 100000), Real.log (bfac p) =
          ∑ n ∈ (U.filter (fun p : Nat.Primes => (p : ℕ) ≤ 100000)).map primesEmb, Real.log (bfac n) by
        rw [Finset.sum_map]; rfl]
      refine Finset.sum_le_sum_of_subset_of_nonneg (fun n hn => ?_) fun n hn _ =>
        Real.log_nonneg (one_le_bfac' (Finset.mem_Ico.mp (Finset.mem_filter.mp hn).1).1)
      obtain ⟨p, hp, rfl⟩ := Finset.mem_map.mp hn
      obtain ⟨-, hp1⟩ := Finset.mem_filter.mp hp
      change (p : ℕ) ∈ headP
      simp only [headP, Finset.mem_filter, Finset.mem_Ico]
      exact ⟨⟨p.2.two_le, by omega⟩, p.2⟩
    have h2 : ∑ p ∈ U.filter (fun p : Nat.Primes => ¬ (p : ℕ) ≤ 100000), Real.log (bfac p) ≤ T := by
      calc ∑ p ∈ U.filter (fun p : Nat.Primes => ¬ (p : ℕ) ≤ 100000), Real.log (bfac p)
          ≤ ∑ p ∈ U.filter (fun p : Nat.Primes => ¬ (p : ℕ) ≤ 100000), (bfac p - 1) :=
            Finset.sum_le_sum fun p _ => Real.log_le_sub_one_of_pos (bfac_pos p.2.two_le)
        _ = ∑ n ∈ (U.filter (fun p : Nat.Primes => ¬ (p : ℕ) ≤ 100000)).map primesEmb, (bfac n - 1) := by
            rw [Finset.sum_map]; rfl
        _ ≤ T := by
            refine tail_sum_le 100000 (by norm_num) _ fun n hn => ?_
            obtain ⟨p, hp, rfl⟩ := Finset.mem_map.mp hn
            obtain ⟨-, hp1⟩ := Finset.mem_filter.mp hp
            exact ⟨p.2, by show 100000 < (p : ℕ); omega⟩
    linarith
  have hlogpos : ∀ p : Nat.Primes, 0 ≤ Real.log (bfac p) := fun p =>
    Real.log_nonneg (one_le_bfac p.2)
  have htsum : ∑' p : Nat.Primes, Real.log (bfac p) ≤ Real.log (∏ p ∈ headP, bfac p) + T :=
    Real.tsum_le_of_sum_le hlogpos hsum
  have hB : Bconst = Real.exp (∑' p : Nat.Primes, Real.log (bfac p)) :=
    (Real.rexp_tsum_eq_tprod (fun p => bfac_pos p.2.two_le) summable_log_bfac).symm
  have hT1 : T < 1 := by linarith
  calc Bconst ≤ Real.exp (Real.log (∏ p ∈ headP, bfac p) + T) := by
        rw [hB]; exact Real.exp_le_exp.mpr htsum
    _ = (∏ p ∈ headP, bfac p) * Real.exp T := by rw [Real.exp_add, Real.exp_log hHpos]
    _ ≤ ((bL : ℝ) / 100000000000000000000) * (1 / (1 - 0.0011868)) := by
        apply mul_le_mul hhead _ (Real.exp_pos T).le (by positivity)
        refine (exp_le_inv_one_sub hT1).trans ?_
        apply one_div_le_one_div_of_le (by norm_num); linarith
    _ < 3.73 := by norm_num [bL]

/-- **`lem:fS`** (all four parts), sorry-free. -/
theorem lemfS_proof : lemfS_Statement := lemfS_of_Bconst Bconst_lt

