/-- `6·200³·c_d · G(k/200)` for `C = c_n/c_d`, where `G(x) = |x|³/6` (`|x| ≤ 1`) and
`G(x) = 1/6 + (|x|-1)/2 + C(|x|-1)²/2` (`|x| > 1`) is the even function with `G'' = F_C(|·|)`. -/
def Gs (cn cd : Int) (k : Int) : Int :=
  if k.natAbs ≤ 200 then cd * (k.natAbs : Int) ^ 3
  else cd * 200 ^ 3 + 3 * cd * 200 ^ 2 * ((k.natAbs : Int) - 200)
    + 600 * cn * ((k.natAbs : Int) - 200) ^ 2

/-- Scaled cell-pair integrals `κ_k = G((k+1)h) - 2G(kh) + G((k-1)h)`, `h = 1/200`. -/
def ks (cn cd : Int) (k : Int) : Int := Gs cn cd (k + 1) - 2 * Gs cn cd k + Gs cn cd (k - 1)

/-- Dot product of two integer lists. -/
def dot (l₁ l₂ : List Int) : Int := (List.zipWith (· * ·) l₁ l₂).sum

/-- `[κ_{-399}, …, κ_{399}]`. -/
def kerList (cn cd : Int) : List Int := (List.range 799).map (fun k : Nat => ks cn cd ((k : Int) - 399))

/-- `∑_i m_i ∑_t m_t κ_{i+t-399}`; for a symmetric list this is `∑_{i,j} m_i m_j κ_{i-j}`. -/
def quadL (l L : List Int) : Int :=
  dot l ((List.range 400).map (fun i => dot l (L.drop i)))

/-- The certificate inequality, denominators cleared:
`h∑m_i² + ∑_{i,j} m_i m_j κ_{i-j} ≤ (B/10⁶)(h∑m_i)²` with `h = 1/200`, `κ = ks/(6·200³·c_d)`. -/
def certCheck (cd B : Int) (l L : List Int) : Bool :=
  decide (6 * 200 ^ 3 * cd * 200000000 * dot l l + 40000000000 * quadL l L
    ≤ B * (6 * 200 ^ 3 * cd) * l.sum ^ 2)

/-- All entries are nonnegative. -/
def nonnegCheck (l : List Int) : Bool := l.all (fun x => decide (0 ≤ x))

theorem ms1_length : ms1.length = 400 := by decide +kernel
theorem ms2_length : ms2.length = 400 := by decide +kernel
theorem ms1_reverse : ms1.reverse = ms1 := by decide +kernel
theorem ms2_reverse : ms2.reverse = ms2 := by decide +kernel
theorem ms1_nonneg : nonnegCheck ms1 = true := by decide +kernel
theorem ms2_nonneg : nonnegCheck ms2 = true := by decide +kernel
theorem ms1_sum_pos : 0 < ms1.sum := by decide +kernel
theorem ms2_sum_pos : 0 < ms2.sum := by decide +kernel

/-- **Certificate `C = 1`**: `𝒬_{F_1}(f) ≤ 1.067718`, i.e. `p(1) ≥ 0.932282`. -/
theorem cert1 : certCheck 1 1067718 ms1 (kerList 1 1) = true := by decide +kernel

/-- **Certificate `C = 1.2688`**: `𝒬_{F_{1.2688}}(f) ≤ 1.114088`, i.e. `p(1.2688) ≥ 0.885912`. -/
theorem cert2 : certCheck 10000 1114088 ms2 (kerList 12688 10000) = true := by decide +kernel

